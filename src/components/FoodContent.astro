---
import Calculator from './Calculator.astro';
import { getAllFoods, hasPage } from '../utils/foods';
import type { Food } from '../utils/foods';
import { getExplanationKey, isEstimate } from '../utils/foods';
import { t, tf, getLangPrefix, getYieldDescription, getFoodSource, getFoodFaqItems } from '../i18n';
import type { Locale } from '../i18n';
import { getFoodName, getShortFoodName, getCategoryLabel } from '../i18n/food-names';
import { getExplanation, getMethodLabel } from '../i18n/content';

interface Props {
  locale: Locale;
  food: Food;
}

const { locale, food } = Astro.props;
const prefix = getLangPrefix(locale);

const isChicken = food.id === 'chicken-breast';
const foodName = getFoodName(locale, food.id);
const yieldDesc = getYieldDescription(locale, food);
const explanation = getExplanation(locale, getExplanationKey(food));
const sourceText = getFoodSource(locale, food);
const estimate = isEstimate(food);
const faqItems = getFoodFaqItems(locale, food);

// `hasPage` matters: the category also holds calculator-only foods (spaghetti,
// veal, chickpeas…) that [food].astro never routes, so linking them 404s.
const relatedFoods = getAllFoods()
  .filter((f) => f.id !== food.id && f.category === food.category && hasPage(f))
  .slice(0, 5);
---

<!-- Food hero -->
<section class="border-b border-[var(--color-hairline)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">

    <!-- Eyebrow -->
    <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
      {getCategoryLabel(locale, food.category)}
      {estimate && ` · ${t(locale, 'food.estimatedYield')}`}
    </p>

    <!-- H1 -->
    <h1 class="text-3xl sm:text-4xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] leading-tight mb-4">
      {foodName}<br class="hidden sm:block" /> {t(locale, 'food.rawToCookedCalc')}
    </h1>

    <!-- Yield stat -->
    <div class="flex items-center gap-3 bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] px-4 py-3 mb-5 w-fit max-w-full">
      <span class="text-2xl font-semibold text-[var(--color-ink)] tabular-nums tracking-tight">
        {food.yield_percent}%
      </span>
      <div>
        <p class="text-sm font-medium text-[var(--color-ink)]">{t(locale, 'food.usdaCookingYield')}</p>
        <p class="text-xs text-[var(--color-mute)]">{yieldDesc}</p>
      </div>
    </div>

    <!-- Explanation -->
    {explanation && (
      <p class="text-sm text-[var(--color-body)] leading-relaxed max-w-xl mb-3">
        {explanation}
      </p>
    )}

    <!-- Source -->
    <p class="text-xs font-mono text-[var(--color-faint)]">
      {t(locale, 'food.source')}: {sourceText}
    </p>
  </div>
</section>

<!-- Chicken-specific: method yields table -->
{isChicken && food.yield_by_method && (
  <section class="border-b border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-5">
        {t(locale, 'food.yieldByMethod')}
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-xl">
        {Object.entries(food.yield_by_method).map(([method, pct]) => (
          <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] px-4 py-4 text-center">
            <p class="text-2xl font-semibold text-[var(--color-ink)] tabular-nums mb-1">{pct}%</p>
            <p class="text-xs text-[var(--color-mute)]">
              {getMethodLabel(locale, method)}
            </p>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-[var(--color-faint)] font-mono">
        {t(locale, 'food.yieldByMethodSource')}
      </p>
    </div>
  </section>
)}

<!-- Chicken-specific: protein quality note -->
{isChicken && (
  <section class="border-b border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="max-w-2xl">
        <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">
          {t(locale, 'food.chickenHeading')}
        </h2>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3">
          {t(locale, 'food.chickenP1')}
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed" set:html={t(locale, 'food.chickenP2')} />
      </div>
    </div>
  </section>
)}

<!-- Calculator -->
<section>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <h2 class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-6">
      {tf(locale, 'food.calcHeading', { name: foodName })}
    </h2>
    <div class="max-w-lg">
      <Calculator preselectedId={food.id} locale={locale} />
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="border-t border-[var(--color-hairline)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-8">
      {t(locale, 'food.faqHeading')}
    </h2>
    <div class="max-w-2xl border-t border-[var(--color-hairline)]">
      {faqItems.map(({ q, a }) => (
        <details class="group border-b border-[var(--color-hairline)]">
          <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
            <span class="text-sm font-semibold text-[var(--color-ink)]">{q}</span>
            <svg class="w-4 h-4 shrink-0 text-[var(--color-mute)] transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <p class="text-sm text-[var(--color-body)] leading-relaxed pb-5 pr-8">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Related foods -->
<section class="border-t border-[var(--color-hairline)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-4">
      {t(locale, 'food.relatedLabel')}
    </p>
    <div class="flex flex-wrap gap-2">
      {relatedFoods.map((f) => (
        <a
          href={`${prefix}/${f.slug}`}
          class="text-sm px-3 py-1.5 bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-pill-category)] text-[var(--color-body)] no-underline hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline-soft)] transition-colors"
        >
          {getShortFoodName(locale, f.id)}
        </a>
      ))}
      <a
        href={`${prefix}/`}
        class="text-sm px-3 py-1.5 bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-pill-category)] text-[var(--color-mute)] no-underline hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline-soft)] transition-colors"
      >
        {t(locale, 'food.allFoods')}
      </a>
    </div>
  </div>
</section>
