---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutContent from '../components/AboutContent.astro';
import { LOCALES } from '../i18n';
import { getAbout } from '../i18n/company';

const locale = 'en';
const page = getAbout(locale);

const BASE = 'https://rawtocookedcalculator.com';
const hreflangUrls: Record<string, string> = { en: `${BASE}/about` };
for (const l of LOCALES) {
  if (l !== 'en') hreflangUrls[l] = `${BASE}/${l}/about`;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: page.metaTitle,
  description: page.metaDescription,
  url: `${BASE}/about`,
  author: {
    '@type': 'Person',
    name: page.bylineName,
    description: page.bylineBio,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Raw to Cooked Calculator',
    url: BASE,
  },
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalUrl={`${BASE}/about`}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <AboutContent locale={locale} />
</BaseLayout>
