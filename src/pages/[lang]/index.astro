---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { t, LOCALES, isValidLocale } from '../../i18n';
import type { Locale } from '../../i18n';
import { getHomeFaq } from '../../i18n/faq';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLocale(lang)) return Astro.redirect('/');
const locale = lang as Locale;

const BASE = 'https://rawtocookedcalculator.com';
const hreflangUrls: Record<string, string> = { en: `${BASE}/` };
for (const l of LOCALES) {
  if (l !== 'en') hreflangUrls[l] = `${BASE}/${l}/`;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: t(locale, 'hero.heading'),
      url: `${BASE}/${locale}/`,
      description: t(locale, 'page.homeDescription'),
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: getHomeFaq(locale).map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<BaseLayout
  title={t(locale, 'page.homeTitle')}
  description={t(locale, 'page.homeDescription')}
  canonicalUrl={`${BASE}/${locale}/`}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <HomeContent locale={locale} />
</BaseLayout>
