---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutContent from '../../components/AboutContent.astro';
import { LOCALES, isValidLocale } from '../../i18n';
import type { Locale } from '../../i18n';
import { getAbout } from '../../i18n/company';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLocale(lang)) return Astro.redirect('/');
const locale = lang as Locale;
const page = getAbout(locale);

const BASE = 'https://rawtocookedcalculator.com';
const hreflangUrls: Record<string, string> = { en: `${BASE}/about` };
for (const l of LOCALES) {
  if (l !== 'en') hreflangUrls[l] = `${BASE}/${l}/about`;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: page.metaTitle,
  description: page.metaDescription,
  url: `${BASE}/${locale}/about`,
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalUrl={`${BASE}/${locale}/about`}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <AboutContent locale={locale} />
</BaseLayout>
