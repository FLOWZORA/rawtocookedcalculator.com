---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import { LOCALES, isValidLocale } from '../../i18n';
import type { Locale } from '../../i18n';
import { getTerms } from '../../i18n/legal';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLocale(lang)) return Astro.redirect('/');
const locale = lang as Locale;
const page = getTerms(locale);

const BASE = 'https://rawtocookedcalculator.com';
const hreflangUrls: Record<string, string> = { en: `${BASE}/terms` };
for (const l of LOCALES) {
  if (l !== 'en') hreflangUrls[l] = `${BASE}/${l}/terms`;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.metaTitle,
  description: page.metaDescription,
  url: `${BASE}/${locale}/terms`,
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalUrl={`${BASE}/${locale}/terms`}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <LegalContent page={page} />
</BaseLayout>
