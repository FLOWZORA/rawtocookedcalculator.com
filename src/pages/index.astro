---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import { t, LOCALES } from '../i18n';

const locale = 'en';

const BASE = 'https://rawtocookedcalculator.com';
const hreflangUrls: Record<string, string> = { en: `${BASE}/` };
for (const lang of LOCALES) {
  if (lang !== 'en') hreflangUrls[lang] = `${BASE}/${lang}/`;
}

const homeFaqItems = [
  {
    q: 'Are nutrition labels based on raw or cooked weight?',
    a: 'Almost all packaged nutrition labels and databases — including USDA FoodData Central — list values based on raw weight unless the label explicitly says "cooked." This is the single most common source of tracking errors: the gram amounts on the label describe raw food, but most people weigh after cooking.',
  },
  {
    q: 'Do calories and macros change when food is cooked?',
    a: 'The total calories and macronutrients in the food do not change from cooking itself. What changes is the weight: water (and sometimes fat) is lost during cooking or absorbed from it. That means the same amount of protein, carbs, and fat is now packed into fewer grams for foods that shrink, or spread across more grams for foods that expand like rice. The food becomes more calorie-dense per gram when it shrinks, and less dense when it expands — but the absolute nutrient totals stay the same.',
  },
  {
    q: 'Should I weigh my food raw or cooked when tracking macros?',
    a: 'Weighing raw is generally more accurate and consistent, especially for meat, since cooking time and method both affect the final cooked weight in ways that are hard to predict. For rice, pasta, and other grains, many people prefer weighing cooked since they batch-cook and portion afterward — that works fine as long as you match the weight to the right database entry (dry/raw vs. cooked). The key is consistency: pick one approach and make sure the app entry you are using matches it.',
  },
  {
    q: 'Why do different apps show different calorie counts for the same food?',
    a: 'The most common reason is that one entry is for raw weight and another is for cooked weight of the same food. Because cooking changes how much water is in the food, the calories per gram differ significantly between raw and cooked entries. It is easy to accidentally select the wrong one. Always check whether the specific database entry you are using says raw or cooked before logging.',
  },
  {
    q: 'Is there a quick way to estimate this without a calculator?',
    a: 'A rough rule of thumb: for baked or roasted chicken breast, divide the cooked weight by about 0.75 to estimate the raw equivalent. But the exact percentage varies by food and cooking method — ground beef, pork, fish, vegetables, and grains all have different yield percentages, and even the same food behaves differently depending on how it is cooked. That is why a per-food calculator like this one gives more accurate results than any single blanket estimate.',
  },
  {
    q: 'How much raw meat do I need per person?',
    a: 'A common planning guideline is roughly 4–6 oz (110–170g) of raw protein per person for a standard meal. This is a general serving-size estimate, separate from the cooking yield data — the actual cooked portion will be smaller due to moisture loss. You can use the calculator to work out how much raw protein to start with for any number of servings.',
  },
  {
    q: 'Why is cooked weight lower for meat but higher for rice?',
    a: 'The direction depends on how each food behaves under heat. Meat, poultry, seafood, and most vegetables start with a lot of water already in them — heat drives that moisture out, so the food loses weight. Dry grains, pasta, and legumes start with very little water and absorb it during boiling, so their weight increases. It is not a single universal rule; it depends on the food\'s starting water content and how it interacts with heat and liquid during cooking.',
  },
  {
    q: 'What does yield percentage mean in cooking?',
    a: 'Yield percentage is the cooked weight expressed as a percentage of the raw weight. A yield of 75% means 100g of raw food becomes 75g after cooking — the food lost weight. A yield above 100% means the food gained weight; for example, white rice has a yield of 300%, meaning 100g dry becomes roughly 300g cooked. Any number below 100% indicates weight loss (most meats and vegetables); any number above 100% indicates weight gain (grains, pasta, legumes). This is the same figure shown in the formula section on this page.',
  },
  {
    q: 'How accurate are these yield percentages?',
    a: 'These are research-based averages from USDA data, not a guarantee for your specific piece of food. Actual results vary by exact cut, size, starting moisture content, and how precisely you control the cooking method — variables that differ every time you cook. The goal is to get you meaningfully closer to accurate than not accounting for cooking loss at all, not to deliver laboratory precision. For most tracking purposes, the error from using these averages is far smaller than the error from assuming raw and cooked weights are the same.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Raw to Cooked Calculator',
      url: BASE,
      description: t(locale, 'page.homeDescription'),
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      keywords: 'raw to cooked converter, raw to cooked calculator, raw to cooked weight conversion calculator, raw to cooked chicken weight, ground beef raw to cooked weight, raw to cooked rice ratio, raw to cooked meat weight conversion calculator, food converter, raw food, cooked food',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      creator: { '@type': 'Organization', name: 'Raw to Cooked Calculator', url: BASE },
    },
    {
      '@type': 'FAQPage',
      mainEntity: homeFaqItems.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};

const categories = [
  {
    label: t(locale, 'browse.catMeat'),
    foods: [
      { name: 'Chicken Breast', slug: 'chicken', note: t(locale, 'browse.note.chicken') },
      { name: 'Ground Beef (80/20)', slug: 'beef', note: t(locale, 'browse.note.beef') },
      { name: 'Salmon Fillet', slug: 'salmon', note: t(locale, 'browse.note.salmon') },
      { name: 'Pork Chop', slug: 'pork', note: t(locale, 'browse.note.pork') },
    ],
  },
  {
    label: t(locale, 'browse.catGrains'),
    foods: [
      { name: 'White Rice', slug: 'rice', note: t(locale, 'browse.note.rice') },
      { name: 'Pasta', slug: 'pasta', note: t(locale, 'browse.note.pasta') },
      { name: 'Lentils', slug: 'lentils', note: t(locale, 'browse.note.lentils') },
      { name: 'Quinoa', slug: 'quinoa', note: t(locale, 'browse.note.quinoa') },
    ],
  },
  {
    label: t(locale, 'browse.catVeg'),
    foods: [
      { name: 'Spinach', slug: 'spinach', note: t(locale, 'browse.note.spinach') },
      { name: 'Broccoli', slug: 'broccoli', note: t(locale, 'browse.note.broccoli') },
      { name: 'Potato', slug: 'potato', note: t(locale, 'browse.note.potato') },
      { name: 'Sweet Potato', slug: 'sweet-potato', note: t(locale, 'browse.note.sweetPotato') },
    ],
  },
];
---

<BaseLayout
  title={t(locale, 'page.homeTitle')}
  description={t(locale, 'page.homeDescription')}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <!-- Hero -->
  <section class="border-b border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-20 text-center">
      <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-5">
        {t(locale, 'hero.eyebrow')}
      </p>
      <h1 class="text-5xl sm:text-7xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] sm:tracking-[-3px] leading-[1.05] mb-6">
        Raw to Cooked<br /> Calculator
      </h1>
      <p class="text-lg sm:text-xl text-[var(--color-body)] max-w-2xl mx-auto leading-relaxed mb-3">
        {t(locale, 'hero.description')}
      </p>
      <p class="text-sm text-[var(--color-mute)]">
        {t(locale, 'hero.usda')}
      </p>
    </div>
  </section>

  <!-- Calculator -->
  <section>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="max-w-lg">
        <Calculator locale={locale} />
      </div>
    </div>
  </section>

  <!-- Category browse -->
  <section class="border-t border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <h2 class="text-2xl font-semibold text-[var(--color-ink)] tracking-[-0.8px] mb-2">
        {t(locale, 'browse.heading')}
      </h2>
      <p class="text-sm text-[var(--color-mute)] mb-8">
        {t(locale, 'browse.description')}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        {categories.map((cat) => (
          <div>
            <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-4">
              {cat.label}
            </p>
            <ul class="space-y-2.5">
              {cat.foods.map((food) => (
                <li>
                  <a
                    href={`/${food.slug}`}
                    class="flex items-center justify-between group no-underline py-2"
                  >
                    <span class="text-sm text-[var(--color-body)] group-hover:text-[var(--color-ink)] transition-colors">
                      {food.name}
                    </span>
                    <span class="text-xs text-[var(--color-faint)] font-mono group-hover:text-[var(--color-mute)] transition-colors ml-4 shrink-0">
                      {food.note}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Conversion formula -->
  <section class="border-t border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-2">
        How the conversion works
      </h2>
      <p class="text-sm text-[var(--color-mute)] mb-8 max-w-xl">
        Every calculation uses a single yield percentage sourced from USDA data. The same two formulas apply to every food.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mb-8">
        <!-- Raw → Cooked -->
        <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] p-5">
          <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
            Raw → Cooked
          </p>
          <p class="font-mono text-sm text-[var(--color-ink)] leading-relaxed">
            cooked = raw × <span class="text-[var(--color-mute)]">(yield% ÷ 100)</span>
          </p>
          <p class="text-xs text-[var(--color-mute)] mt-3 leading-relaxed">
            Example: 200g raw chicken × 0.75 = <strong class="text-[var(--color-ink)]">150g cooked</strong>
          </p>
        </div>

        <!-- Cooked → Raw -->
        <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] p-5">
          <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
            Cooked → Raw
          </p>
          <p class="font-mono text-sm text-[var(--color-ink)] leading-relaxed">
            raw = cooked ÷ <span class="text-[var(--color-mute)]">(yield% ÷ 100)</span>
          </p>
          <p class="text-xs text-[var(--color-mute)] mt-3 leading-relaxed">
            Example: 150g cooked chicken ÷ 0.75 = <strong class="text-[var(--color-ink)]">200g raw</strong>
          </p>
        </div>
      </div>

      <!-- Macro note -->
      <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] p-5 max-w-2xl">
        <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
          Macro calculation rule
        </p>
        <p class="font-mono text-sm text-[var(--color-ink)] leading-relaxed mb-3">
          macros = <span class="text-[var(--color-mute)]">(raw_g ÷ 100)</span> × macros_per_100g_raw
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed">
          Macros are always derived from the <strong class="text-[var(--color-ink)]">raw weight equivalent</strong>, regardless of which direction you're converting.
          USDA nutrition data is measured on raw food, so this keeps all macro outputs consistent with what's on the label.
        </p>
      </div>
    </div>
  </section>

  <!-- Spinach callout -->
  <section class="border-t border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] p-6 max-w-2xl">
        <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
          {t(locale, 'callout.eyebrow')}
        </p>
        <h3 class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-2">
          {t(locale, 'callout.heading')}
        </h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-4">
          {t(locale, 'callout.description')}
        </p>
        <div class="flex gap-3 flex-wrap">
          <a
            href="/spinach"
            class="text-xs px-3 py-1.5 bg-[var(--color-ink)] text-[var(--color-canvas)] rounded-[var(--radius-pill)] font-medium no-underline hover:opacity-80 transition-opacity"
          >
            {t(locale, 'callout.spinachBtn')}
          </a>
          <a
            href="/rice"
            class="text-xs px-3 py-1.5 bg-[var(--color-surface)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] font-medium no-underline hover:bg-[var(--color-hairline-soft)] transition-colors"
          >
            {t(locale, 'callout.riceBtn')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why trust this data -->
  <section class="border-t border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-6">
        {t(locale, 'usda.heading')}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl">
        <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] p-5">
          <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-2">
            {t(locale, 'usda.meatLabel')}
          </p>
          <p class="text-sm text-[var(--color-body)] leading-relaxed" set:html={t(locale, 'usda.meatText')} />
        </div>
        <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] p-5">
          <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-2">
            {t(locale, 'usda.grainsLabel')}
          </p>
          <p class="text-sm text-[var(--color-body)] leading-relaxed" set:html={t(locale, 'usda.grainsText')} />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-8">
        Frequently asked questions
      </h2>
      <div class="max-w-2xl border-t border-[var(--color-hairline)]">
        {homeFaqItems.map(({ q, a }) => (
          <details class="group border-b border-[var(--color-hairline)]">
            <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <span class="text-sm font-semibold text-[var(--color-ink)]">{q}</span>
              <svg class="w-4 h-4 shrink-0 text-[var(--color-mute)] transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <p class="text-sm text-[var(--color-body)] leading-relaxed pb-5 pr-8">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO article -->
  <section class="border-t border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <article class="max-w-2xl prose-custom">

        <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">
          About This Raw to Cooked Weight Conversion Calculator
        </h2>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-4">
          This raw to cooked converter takes the guesswork out of one of the most persistent problems in food tracking: the gap between what you weigh on a kitchen scale and what a nutrition label actually describes. Most calorie databases — including USDA FoodData Central — publish macros based on raw food weights. But most people cook before eating. This free food converter lets you enter either a raw or cooked weight, then instantly calculates the equivalent on the other side along with accurate calories, protein, carbs, and fat for that specific amount.
        </p>

        <h3 class="text-base font-semibold text-[var(--color-ink)] tracking-tight mt-8 mb-3">
          Why Raw Food and Cooked Food Weigh Differently
        </h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3">
          The reason raw food and cooked food have different weights comes down to moisture. When you cook meat, water evaporates and fat renders out — your cooked food ends up lighter than the raw food you started with. Grains and legumes do the opposite: they absorb water during boiling, so cooked food is heavier than the raw food going in.
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-4">
          This means you cannot use a single "gram = gram" assumption across your day. A raw to cooked weight conversion calculator solves that by applying each food's specific yield percentage — the ratio of cooked weight to raw weight — which varies widely between foods. Chicken and beef lose around a quarter of their weight. Spinach loses 70%. White rice almost triples.
        </p>

        <h3 class="text-base font-semibold text-[var(--color-ink)] tracking-tight mt-8 mb-3">
          Raw to Cooked Chicken Weight
        </h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3">
          Raw to cooked chicken weight is probably the most important conversion for anyone tracking protein. Boneless, skinless chicken breast loses approximately 25% of its weight when cooked — whether baked, grilled, or pan-fried. That means 200g raw chicken becomes about 150g cooked.
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-4">
          The practical consequence: if you weigh your chicken after cooking and log it as 150g against a raw-weight nutrition label, you will be tracking the macros for only 150g raw — undercounting by 50g. The correct approach is either to weigh raw before cooking, or use a raw to cooked calculator to convert the cooked weight back to its raw equivalent before logging.
        </p>

        <h3 class="text-base font-semibold text-[var(--color-ink)] tracking-tight mt-8 mb-3">
          Ground Beef Raw to Cooked Weight
        </h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3">
          Ground beef raw to cooked weight depends on fat content. Standard 80/20 ground beef loses roughly 27% of its mass as both water and fat render out during cooking. A 200g raw portion yields about 146g cooked. Leaner 90/10 ground beef loses only 18–20% because there is less fat to render.
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-4">
          This raw to cooked meat weight conversion calculator uses an 80/20 default for ground beef, matching USDA-measured yield data for the most common retail fat percentage.
        </p>

        <h3 class="text-base font-semibold text-[var(--color-ink)] tracking-tight mt-8 mb-3">
          Raw to Cooked Rice Ratio
        </h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3">
          The raw to cooked rice ratio runs in the opposite direction from meat. Dry white rice absorbs water during cooking and expands to roughly 3× its original weight — 100g dry rice becomes approximately 300g cooked. That means a 300g bowl of cooked rice contains only the calories of 100g dry, which surprises many people who assume cooked and dry rice have the same calorie density per gram.
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-4">
          Using an accurate raw to cooked calculator for rice is especially important because the error compounds quickly. If you eat two cups of cooked rice daily and log the cooked weight against a dry-weight label, you will be significantly overestimating the calorie content of that food.
        </p>

        <h3 class="text-base font-semibold text-[var(--color-ink)] tracking-tight mt-8 mb-3">
          Built on Official USDA Data
        </h3>
        <p class="text-sm text-[var(--color-body)] leading-relaxed">
          Every yield figure powering this raw to cooked converter comes from official USDA sources — the same databases used by dietitians, food manufacturers, and health researchers. Meat and poultry yields come from the USDA Table of Cooking Yields for Meat and Poultry. Grain and vegetable yields are derived by comparing raw and cooked entries in USDA FoodData Central. This makes our raw to cooked calculator more reliable than fitness apps that use crowdsourced estimates or unverified averages. Whether you are converting raw to cooked chicken weight, checking ground beef raw to cooked weight, or working out the raw to cooked rice ratio, every answer here is anchored in published, peer-reviewed science.
        </p>

      </article>
    </div>
  </section>
</BaseLayout>
